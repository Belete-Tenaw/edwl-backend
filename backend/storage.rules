rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read/write for verified users, but restrict sensitive paths
      allow read, write: if request.auth != null;
    }
    
    // Platinum-Only Folders: Police and Health documents
    match /documents/{userId}/{docType}/{fileName} {
      allow read: if request.auth != null && 
                  (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'PLATINUM' || 
                   request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
