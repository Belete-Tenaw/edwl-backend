rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Context-Aware Validation
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') 
             && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
    function isValidVideo() {
      return request.resource.contentType.matches('video/.*'); // 50MB restriction removed
    }

    // User Media Sandboxing
    match /users/{userId}/{mediaType}/{fileName} {
      allow read: if isOwner(userId) || isSuperAdmin();
      
      allow write: if isSuperAdmin() || (isOwner(userId) && (
        (mediaType == 'images' && isValidImage()) ||
        (mediaType == 'videos' && isValidVideo())
      ));
      
      allow delete: if isOwner(userId) || isSuperAdmin();
    }
  }
}
