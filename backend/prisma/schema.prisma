// 1. DATABASE CONFIGURATION
// In Prisma v7, ensure the env() calls are exactly as mapped in your .env file.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 2. EMPLOYER MODEL
model Employer {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String
  contactName        String
  employerType       String             // HOUSEHOLD or BUSINESS
  address            String?
  familySize         Int?
  profilePhoto       String?
  idDocument         String?
  verificationStatus String             @default("PENDING")
  isVerified         Boolean            @default(false)
  tier               String             @default("FREEMIUM")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relation link to the hiring requirements
  hiringRequirement  HiringRequirement? 
}

// 3. HIRING REQUIREMENT MODEL
model HiringRequirement {
  id                String   @id @default(uuid())
  employerId        String   @unique
  employer          Employer @relation(fields: [employerId], references: [id])

  // Basic Information
  employerType      String   
  preferredLanguage String   @default("Amharic")
  urgencyLevel      String   

  // Job Definition
  jobTypes          String[] 
  workerCount       Int      @default(1)
  responsibilities  String?  @db.Text

  // Worker Profile Preferences
  prefAgeRange      String?
  prefGender        String?
  prefExperience    String?  

  // Work Arrangement & Schedule
  workType          String   
  workingHours      String?
  salaryMin         Int?
  salaryMax         Int?
  isSalaryNegotiable Boolean @default(true)
  benefits          String[] 

  // Trust, Safety & Compliance
  idRequired        Boolean  @default(true)
  trialPeriodDays   Int      @default(0)

  // Matching Priority Weights (Scale 1-5)
  weightExperience  Int      @default(3)
  weightSalary      Int      @default(3)
  weightLocation    Int      @default(3)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}