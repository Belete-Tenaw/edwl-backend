rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down default access - all profile reads/writes happen via backend API
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.superAdmin == true;
    }
    // Allow secure chat/message endpoints if migrating off Socket.io
    match /messages/{messageId} {
      allow read, write: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }
  }
}
