# EDWL Backend - Environment Variable Template (Production)

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For production, use a managed database service (e.g., AWS RDS, Azure Database)
# or a secure Docker volume.
DATABASE_URL="postgresql://user:strong_password@host:port/edwl_db?pgbouncer=true"
DIRECT_URL="postgresql://user:strong_password@host:port/edwl_db"

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Generate a cryptographically strong secret (e.g., openssl rand -base64 48)
# DO NOT share this or commit it to version control.
JWT_SECRET="generate_a_strong_64_character_random_string_here"

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (Placeholders)
# -----------------------------------------------------------------------------
# TELEBIRR_APP_KEY=
# CHAPA_SECRET_KEY=
